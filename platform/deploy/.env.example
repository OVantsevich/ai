# Copy to platform/deploy/.env (make init does this) and fill in values.

# Common
TZ=Europe/Warsaw

# GitLab (work). All actions are performed on behalf of the token owner.
GITLAB_URL=https://gitlab.hamkorbank.uz
GITLAB_TOKEN=
# Bearer token clients must send to gitlab-mcp-ro/rw (make init generates it)
GITLAB_MCP_AUTH_TOKEN=

# Atlassian (Jira + Confluence) via remote Rovo MCP, API token auth.
ATLASSIAN_SITE=https://hmb.atlassian.net
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=

# Telegram (approvals and notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Platform storage
POSTGRES_USER=ai
POSTGRES_PASSWORD=ai
POSTGRES_DB=ai

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Git identity used by agents in work repositories
GIT_WORK_NAME=
GIT_WORK_EMAIL=

# LLM engine: selected at the final stage
