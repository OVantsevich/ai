{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Common definitions",
  "$defs": {
    "ref": {
      "description": "Reference to a shared resource: <system>:<locator>",
      "type": "string",
      "pattern": "^(gitlab|jira|confluence|url):.+$"
    },
    "refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/ref" },
      "uniqueItems": true
    },
    "roleId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "stepKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration_ms": { "type": "integer", "minimum": 0 },
        "model": { "type": "string" },
        "tokens_in": { "type": "integer", "minimum": 0 },
        "tokens_out": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "turns": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
