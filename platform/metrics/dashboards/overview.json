{
  "uid": "ai-overview",
  "title": "Overview",
  "tags": ["ai-pipeline"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1, "title": "Tasks by status", "type": "stat",
      "gridPos": { "h": 5, "w": 16, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "ai-postgres" },
      "targets": [{
        "refId": "A", "format": "table", "rawSql":
        "SELECT status AS metric, count(*)::bigint AS value FROM tasks GROUP BY status ORDER BY status"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal", "textMode": "value_and_name", "colorMode": "background", "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 0 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "done" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "failed" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "blocked" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "running" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "awaiting_approval" }, "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 2, "title": "Active now", "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "ai-postgres" },
      "targets": [{
        "refId": "A", "format": "table", "rawSql":
        "SELECT count(*)::bigint AS \"active\" FROM tasks WHERE status IN ('planning','awaiting_approval','running','blocked')"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } }
    },
    {
      "id": 3, "title": "Done (window)", "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "ai-postgres" },
      "targets": [{
        "refId": "A", "format": "table", "rawSql":
        "SELECT count(*)::bigint AS \"done\" FROM tasks WHERE status = 'done' AND $__timeFilter(finished_at)"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } } }
    },
    {
      "id": 4, "title": "Where each task is", "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 5 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "ai-postgres" },
      "targets": [{
        "refId": "A", "format": "table", "rawSql":
        "SELECT t.id AS task, t.title, t.status,\n  coalesce((\n    SELECT s.step_key || coalesce(' (' || s.role || ')', '')\n    FROM steps s JOIN plans p ON p.id = s.plan_id\n    WHERE p.task_id = t.id AND p.status = 'approved'\n      AND s.status IN ('running','needs_approval','blocked','failed','ready')\n    ORDER BY s.started_at NULLS LAST, s.id LIMIT 1\n  ), CASE t.status WHEN 'done' THEN '—' WHEN 'awaiting_approval' THEN 'plan approval' WHEN 'planning' THEN 'coordinator' ELSE '—' END) AS current_step,\n  round(extract(epoch FROM coalesce(t.finished_at, now()) - t.created_at) / 60.0, 1) AS minutes,\n  (SELECT count(*) FROM plans WHERE task_id = t.id) AS plan_versions,\n  t.created_at\nFROM tasks t\nWHERE $__timeFilter(t.created_at)\nORDER BY t.id DESC"
      }],
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "minutes" }, "properties": [{ "id": "unit", "value": "m" }, { "id": "decimals", "value": 1 }] },
          { "matcher": { "id": "byName", "options": "created_at" }, "properties": [{ "id": "custom.width", "value": 180 }] }
        ]
      }
    },
    {
      "id": 5, "title": "Tasks created", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "ai-postgres" },
      "targets": [{
        "refId": "A", "format": "time_series", "rawSql":
        "SELECT $__timeGroupAlias(created_at, 1d), count(*)::bigint AS tasks\nFROM tasks WHERE $__timeFilter(created_at)\nGROUP BY 1 ORDER BY 1"
      }],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 20, "drawStyle": "bars", "lineWidth": 1 }, "color": { "mode": "palette-classic" } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 6, "title": "Role time per finished task", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "ai-postgres" },
      "targets": [{
        "refId": "A", "format": "time_series", "rawSql":
        "SELECT t.finished_at AS time, r.role AS metric, (sum(r.duration_ms) / 1000.0) AS value\nFROM runs r JOIN tasks t ON t.id = r.task_id\nWHERE t.status = 'done' AND r.finished_at IS NOT NULL AND $__timeFilter(t.finished_at)\nGROUP BY 1, 2 ORDER BY 1"
      }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 40, "stacking": { "mode": "normal", "group": "A" }, "drawStyle": "bars" } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
